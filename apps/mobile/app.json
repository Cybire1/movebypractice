{
  "expo": {
    "name": "Glide",
    "slug": "glide-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "glide",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1628"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.glide.learn",
      "infoPlist": {
        "NSCameraUsageDescription": "Glide needs camera access for live classes",
        "NSMicrophoneUsageDescription": "Glide needs microphone access for live classes"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1628"
      },
      "package": "com.glide.learn",
      "permissions": ["CAMERA", "RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "Allow Glide to use your microphone for live classes"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
